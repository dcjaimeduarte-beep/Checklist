# Banco de dados
DATABASE_URL=

# Auth
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App
NODE_ENV=development
APP_PORT=3333
WEB_PORT=3000

# Segurança
BCRYPT_OR_ARGON_STRATEGY=argon2id
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Auditoria
AUDIT_LOG_ENABLED=true
